{
  "name": "one-videos",
  "version": "1.0.0",
  "private": true,
  "description": "ONE videos: motion design in Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Main out/main.mp4",
    "render:vertical": "remotion render Vertical out/vertical.mp4",
    "render:square": "remotion render Square out/square.mp4",
    "still": "remotion still Main out/still.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "@remotion/noise": "4.0.538",
    "@remotion/paths": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
